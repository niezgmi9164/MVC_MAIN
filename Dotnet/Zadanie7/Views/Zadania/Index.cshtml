@model ZadaniaZespolu.Models.ZadanieFiltrViewModel

@{
    ViewData["Title"] = "Lista zadań";
}

<h1>Lista zadań</h1>

<p>
    <a asp-action="Create">Dodaj nowe zadanie</a>
</p>

<form asp-controller="Zadania" asp-action="Index" method="get">
    <p>
        <label>Tytuł: <input type="text" asp-for="SzukanyTekst" /></label>

        <select asp-for="Projekt" asp-items="Model.Projekty">
            <option value="">Wszystkie projekty</option>
        </select>

        <select asp-for="Status" asp-items="Html.GetEnumSelectList<ZadaniaZespolu.Models.Status>()">
            <option value="">Wszystkie statusy</option>
        </select>

        <input type="submit" value="Filtruj" />
    </p>
</form>

<table class="table table-striped table-hover">
    <thead class="table-primary">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Zadania![0].Tytul)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Zadania![0].Projekt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Zadania![0].Osoba)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Zadania![0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Zadania![0].Priorytet)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Zadania![0].TerminWykonania)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Zadania!)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Tytul)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Projekt)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Osoba)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Status)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Priorytet)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TerminWykonania)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edytuj</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Szczegóły</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Usuń</a>
                </td>
            </tr>
        }
    </tbody>
</table>
